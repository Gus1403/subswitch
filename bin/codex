#!/usr/bin/env bash
# Select the active Codex account home, then hand off to the real Codex binary.
#
# This shim also guards the two Codex commands proven to destroy logins:
#   * `codex logout` — the ONLY confirmed explicit refresh-token revoker.
#   * bare `codex login` (no CODEX_HOME) — writes into whichever home the
#     pointer currently selects, which is how the same account ends up in two
#     homes, the condition that permanently revokes one of them.
# Neither is blocked: each prints the concrete risk for the RESOLVED home and
# account, then asks for confirmation.  Non-interactive callers (agents) are
# refused unless they opt in explicitly, so no subagent can silently revoke an
# account.  Rationale and full rules: docs/danger-commands.md
#
# Everything else (exec, resume, ...) passes through untouched.

# Resolve the real Codex binary. Codex may be installed by Homebrew, npm, or
# anywhere else on PATH, so this must not assume one location. Order:
#   1. SUBSWITCH_REAL_CODEX  — explicit override (also how the tests inject a stub)
#   2. the first `codex` on PATH that is not this shim (compared by inode via
#      -ef, so a symlink to this shim can never match and cause a re-exec loop)
#   3. the usual install prefixes, as a last resort
resolve_real_codex() {
  if [[ -n "${SUBSWITCH_REAL_CODEX:-}" ]]; then
    printf '%s' "$SUBSWITCH_REAL_CODEX"
    return
  fi
  local candidate
  while IFS= read -r candidate; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    [[ "$candidate" -ef "${BASH_SOURCE[0]}" ]] && continue
    printf '%s' "$candidate"
    return
  done < <(type -a -P codex 2>/dev/null || :)
  for candidate in /opt/homebrew/bin/codex /usr/local/bin/codex; do
    [[ -x "$candidate" ]] && { printf '%s' "$candidate"; return; }
  done
  printf '%s' "/opt/homebrew/bin/codex"
}

real_codex="$(resolve_real_codex)"
config_dir="${SUBSWITCH_CONFIG_HOME:-"$HOME/.config/subswitch"}"
pointer_file="$config_dir/codex-current"
danger_doc="$config_dir/DANGER.md"
selected_home=""

# Remember whether the caller pinned the home BEFORE the pointer may set it.
explicit_home="${CODEX_HOME+set}"

# An explicit CODEX_HOME is an operator override.  In particular, do not read
# the pointer or change even an explicitly empty value.
if [[ -z "${CODEX_HOME+x}" ]]; then
  if [[ -f "$pointer_file" && -r "$pointer_file" ]] && { exec 9< "$pointer_file"; } 2>/dev/null; then
    IFS= read -r selected_home <&9 || :
    extra_line=""
    # A pointer is exactly one line.  Reject a second line, including blank,
    # rather than accidentally honoring the first half of a corrupt file.
    if IFS= read -r extra_line <&9 || [[ -n "$extra_line" ]]; then
      selected_home=""
    fi
    exec 9<&-
    if [[ "$selected_home" == /* && -d "$selected_home" && -f "$selected_home/auth.json" ]]; then
      export CODEX_HOME="$selected_home"
    fi
  fi
fi

# Observability must never make a Codex launch fail.  %q keeps spaces and
# unusual argument characters readable without letting them create log lines.
mkdir -p "$config_dir/logs" 2>/dev/null || :
{
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || :)"
  printf '%s home=%q arg1=%q arg2=%q\n' \
    "$timestamp" "${CODEX_HOME-<default>}" "${1-}" "${2-}" >> "$config_dir/logs/shim.log"
} 2>/dev/null || :

# ---------------------------------------------------------------- danger guard
subswitch_account_of() {
  # Print "email (account_id)" for a home, or "unknown account" — never fatal.
  /usr/bin/python3 - "$1" 2>/dev/null <<'PY' || printf 'unknown account'
import base64, json, os, sys
try:
    t = (json.load(open(os.path.join(sys.argv[1], "auth.json"))).get("tokens") or {})
except Exception:
    print("unknown account"); raise SystemExit
email = None
parts = str(t.get("id_token", "")).split(".")
if len(parts) == 3:
    try:
        pad = parts[1] + "=" * (-len(parts[1]) % 4)
        email = json.loads(base64.urlsafe_b64decode(pad)).get("email")
    except Exception:
        pass
print("%s (%s)" % (email or "unknown", t.get("account_id") or "no account_id"))
PY
}

subswitch_confirm() {
  # $1 = override env var name, $2 = phrase the operator must type.
  local override_var="$1" phrase="$2" typed=""
  # Only an explicit "1" authorizes; any other value (including "0") does not.
  if [[ "${!override_var-}" == "1" ]]; then
    printf '   → proceeding: %s=1.\n\n' "$override_var" >&2
    return 0
  fi
  # Only interactive if the controlling terminal actually opens. An agent or
  # piped caller has none, so this fails closed (refuse) rather than hang.
  if ! { exec 3</dev/tty; } 2>/dev/null; then
    printf '   ✗ REFUSED: no interactive terminal (an agent or script called this).\n' >&2
    printf '     If you really intend this, re-run with %s=1\n\n' "$override_var" >&2
    return 1
  fi
  printf '   To proceed, type exactly: %s\n   > ' "$phrase" >&2
  IFS= read -r typed <&3 || typed=""
  exec 3<&-
  if [[ "$typed" == "$phrase" ]]; then
    printf '   → confirmed.\n\n' >&2
    return 0
  fi
  printf '   ✗ Cancelled (nothing was changed).\n\n' >&2
  return 1
}

# Find the effective subcommand: codex accepts global options before it
# (`codex -c k=v logout`), so guarding only $1 would be bypassable. Treat a bare
# `logout`/`login` token anywhere in the args as the subcommand — no legitimate
# non-subcommand argument is exactly that word (prompts are quoted strings).
guard_cmd=""
for _arg in "$@"; do
  if [[ "$_arg" == "logout" || "$_arg" == "login" ]]; then
    guard_cmd="$_arg"
    break
  fi
done

case "$guard_cmd" in
  logout)
    target="${CODEX_HOME:-$HOME/.codex}"
    printf '\n\033[1;31m⚠️  codex logout REVOKES a login — permanently.\033[0m\n' >&2
    printf '   Home:    %s\n' "$target" >&2
    printf '   Account: %s\n' "$(subswitch_account_of "$target")" >&2
    printf '   logout is the ONLY confirmed action that revokes a Codex refresh\n' >&2
    printf '   token server-side. The account stops working immediately and the\n' >&2
    printf '   only recovery is a browser re-login.\n' >&2
    [[ -z "$explicit_home" ]] && printf '   NOTE: this home came from the pointer, not from you.\n' >&2
    printf '   Details: %s\n\n' "$danger_doc" >&2
    subswitch_confirm SUBSWITCH_ALLOW_LOGOUT "revoke $(basename "$target")" || exit 1
    ;;
  login)
    if [[ -z "$explicit_home" ]]; then
      target="${CODEX_HOME:-$HOME/.codex}"
      printf '\n\033[1;33m⚠️  bare `codex login` writes into a home you did not choose.\033[0m\n' >&2
      printf '   Would write to: %s\n' "$target" >&2
      printf '   Currently:      %s\n' "$(subswitch_account_of "$target")" >&2
      printf '   If you pick an account that already lives in another home, BOTH\n' >&2
      printf '   logins can be invalidated, permanently.\n' >&2
      printf '   \033[1mSafer:\033[0m bin/codex-relogin.sh <home>  (pins the home, refuses\n' >&2
      printf '   duplicates and live processes, and verifies afterward).\n' >&2
      printf '   Details: %s\n\n' "$danger_doc" >&2
      subswitch_confirm SUBSWITCH_ALLOW_BARE_LOGIN "login $(basename "$target")" || exit 1
    fi
    ;;
esac

exec "$real_codex" "$@"
